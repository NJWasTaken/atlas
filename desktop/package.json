{
  "name": "atlas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A personal learning environment for university students",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "package:dir": "electron-builder --dir",
    "package": "electron-builder",
    "release:validate": "node scripts/validate-release.mjs",
    "test:release": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.noeljose.atlas",
    "productName": "Atlas",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "Atlas-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "shortcutName": "Atlas",
      "uninstallDisplayName": "Atlas"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Noel Jose",
      "desktop": {
        "entry": {
          "Name": "Atlas",
          "Comment": "A personal learning environment",
          "Categories": "Education;"
        }
      },
      "executableName": "atlas"
    },
    "copyright": "Copyright © 2026 Atlas"
  },
  "author": {
    "name": "Noel Jose",
    "email": "noel@example.com"
  },
  "homepage": "https://github.com/NJWasTaken/atlas"
}
